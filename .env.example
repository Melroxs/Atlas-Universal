# ---------------------------------------------------------------------------
# Atlas on Supabase — environment variables
#
# Copy this file to `.env.local` and fill in your Supabase project keys.
# Get them from your Supabase project dashboard → Settings → API:
#   VITE_SUPABASE_URL       = Project URL        (https://<ref>.supabase.co)
#   VITE_SUPABASE_ANON_KEY  = anon / public key  (JWT, safe to ship in the
#                                                 browser bundle — RLS locks
#                                                 every table down)
#
# The server-side secrets (SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY) are used
# only by Supabase Edge Functions / the platform, never by this module.
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
